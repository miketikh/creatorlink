{
  "category": "social",
  "tone": "warm-casual",
  "length": "short-medium",
  "mechanics": {
    "capitalization": "sentence-case",
    "punctuation": "minimal",
    "spellingStyle": "casual-shortcuts"
  },
  "vocabulary": {
    "greetings": {
      "standard": ["hey", "hi", "heyy"],
      "alternatives": ["hey!", "what's up", "hi there"]
    },
    "closings": {
      "standard": ["talk soon", "bye"],
      "alternatives": ["miss you", "ttyl", "love ya", "chat later"]
    },
    "commonWords": {
      "what's up": ["what's up", "how are you", "sup"],
      "you": ["you", "u"],
      "are": ["are"],
      "probably": ["probably", "prob"],
      "okay": ["okay", "ok", "sounds good"]
    },
    "fillerWords": ["like", "honestly", "lol", "haha", "totally"],
    "signaturePhrases": ["that's awesome", "no way", "same", "love that", "so good", "amazing"]
  },
  "expressiveness": {
    "emojis": "sometimes",
    "commonEmojis": ["😂", "❤️", "😊", "🙌", "✨", "💕", "👍"],
    "exclamations": "sometimes",
    "multiPunctuation": true,
    "ellipsis": true
  },
  "structure": {
    "avgLength": "1-2 sentences",
    "breakIntoMultiple": true,
    "useLineBreaks": false
  }
}