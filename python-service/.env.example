# Firebase Emulator Configuration
# These variables tell Firebase Admin SDK to connect to local emulators instead of production
GCLOUD_PROJECT=creatorlink-c160a
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIREBASE_DATABASE_EMULATOR_URL=http://localhost:9000
FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

# FastAPI Server Configuration
HOST=0.0.0.0
PORT=8000

# Vector Database Configuration (In-Memory Qdrant)
QDRANT_HOST=:memory:  # Special value for in-memory mode (no Docker needed)
QDRANT_COLLECTION_NAME=message_embeddings

# OpenAI Configuration
OPENAI_API_KEY=sk-proj-...  # Get from https://platform.openai.com/api-keys
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
